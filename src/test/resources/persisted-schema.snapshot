class Creature {
  caughtAtMs: long
  gilded: boolean
  hpFraction: double
  hpStampMs: long
  nickname: String
  npcId: int
  rollAttack: int
  rollDefence: int
  rollHp: int
  rollSpeed: int
  species: String
  temperament: String
  xp: long
}
class Egg {
  rarity: String
  tilesLeft: int
  tilesTotal: int
}
class SaveData {
  battlesWon: int
  caught: Map<String, Integer>
  eggs: List<Egg>
  eliteClears: int
  gilded: Set<String>
  items: Map<String, Integer>
  jars: Map<String, Integer>
  milestones: Set<String>
  seen: Set<String>
  selectedJar: String
  sigils: Set<String>
  stepProgress: int
  storage: List<Creature>
  tasks: TaskProgress
  team: List<Creature>
  trainerXp: long
  version: int
}
class TaskProgress {
  daily: int[]
  dailyPaid: boolean[]
  day: long
  lastCatchDay: long
  streak: int
  week: long
  weekly: int
  weeklyPaid: boolean
}
